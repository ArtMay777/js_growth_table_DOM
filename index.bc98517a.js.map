"use strict";
var table = document.querySelector(".field");
var appendRowButton = document.querySelector(".append-row");
var removeRowButton = document.querySelector(".remove-row");
var appendColumn = document.querySelector(".append-column");
var removeColumn = document.querySelector(".remove-column");
appendRowButton.addEventListener("click", function() {
    var tbody = table.querySelector("tbody");
    if (tbody.children.length >= 10) return;
    var firstRow = table.querySelector("tr");
    var columnCount = firstRow.children.length;
    var newRow = document.createElement("tr");
    for(var i = 0; i < columnCount; i++){
        var newCell = document.createElement("td");
        newRow.append(newCell);
    }
    tbody.append(newRow);
    removeRowButton.disabled = false;
    if (tbody.children.length === 10) appendRowButton.disabled = true;
});
removeRowButton.addEventListener("click", function() {
    var tbody = table.querySelector("tbody");
    if (tbody.children.length <= 2) return;
    tbody.lastElementChild.remove();
    appendRowButton.disabled = false;
    if (tbody.children.length === 2) removeRowButton.disabled = true;
});
appendColumn.addEventListener("click", function() {
    var tbody = table.querySelector("tbody");
    var rows = tbody.querySelectorAll("tr");
    if (rows[0].children.length >= 10) return;
    rows.forEach(function(row) {
        var newCell = document.createElement("td");
        row.append(newCell);
    });
    removeColumn.disabled = false;
    if (rows[0].children.length === 10) appendColumn.disabled = true;
});
removeColumn.addEventListener("click", function() {
    var tbody = table.querySelector("tbody");
    var rows = tbody.querySelectorAll("tr");
    if (rows[0].children.length <= 2) return;
    rows.forEach(function(row) {
        row.lastElementChild.remove();
    });
    appendColumn.disabled = false;
    if (rows[0].children.length === 2) removeColumn.disabled = true;
});

